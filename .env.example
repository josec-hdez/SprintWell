# SprintWell — environment template
# Copy this file to .env and adjust values for your local setup.
# .env is gitignored; .env.example is the source of truth for required variables.

# ─── PostgreSQL (consumed by docker-compose.yml) ───
POSTGRES_USER=sprintwell
POSTGRES_PASSWORD=sprintwell
POSTGRES_DB=sprintwell
POSTGRES_PORT=5432

# ─── Prisma connection string (consumed by backend) ───
# Host is `localhost` because the backend runs on the host during dev, not inside compose.
# When the backend is dockerized later (Semana 2-3), change `localhost` to `postgres`
# (the compose service name) so the backend container can reach the DB on the compose network.
DATABASE_URL=postgresql://sprintwell:sprintwell@localhost:5432/sprintwell?schema=public
