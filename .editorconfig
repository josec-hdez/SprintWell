# EditorConfig — https://editorconfig.org
# Top-most EditorConfig file for the SprintWell monorepo.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# TypeScript / JavaScript / JSON / YAML / Markdown — 2 spaces
[*.{ts,tsx,js,jsx,json,yml,yaml,md}]
indent_size = 2

# Python (optimizer) — 4 spaces (PEP 8)
[*.py]
indent_size = 4
