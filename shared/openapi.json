  "info": {
    "title": "SprintWell API",
    "description": "Sprint planning backend — admin, member and public endpoints.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "admin@sprintwell.dev"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "correct horse battery staple"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Signed JWT for the Authorization: Bearer header."
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "CreateMemberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "alice@example.com"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Alice"
          },
          "role": {
            "enum": [
              "MEMBER",
              "ADMIN"
            ],
            "type": "string",
            "example": "MEMBER"
          },
          "initialPassword": {
            "type": "string",
            "minLength": 8,
            "example": "changeme123"
          }
        },
        "required": [
          "email",
          "name",
          "role",
          "initialPassword"
        ]
      },
      "MemberResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "AssignSkillDto": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string",
            "minLength": 1,
            "example": "skill-uuid"
          },
          "level": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 3
          }
        },
        "required": [
          "skillId",
          "level"
        ]
      },
      "CreateSkillDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Python"
          }
        },
        "required": [
          "name"
        ]
      },
      "SkillResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      },
      "TaskResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "effortDays": {
            "type": "number"
          },
          "category": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "deadlineDay": {
            "type": "number",
            "nullable": true
          },
          "requiredSkills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "effortDays",
          "category",
          "domain",
          "deadlineDay",
          "requiredSkills",
          "dependsOn",
          "status"
        ]
      },
      "SprintResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "startDate": {
            "type": "string"
          },
          "durationDays": {
            "type": "number"
          },
          "tasks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskResponseDto"
            }
          }
        },
        "required": [
          "id",
          "name",
          "startDate",
          "durationDays",
          "tasks"
        ]
      },
      "CreateSprintDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Sprint 12"
          },
          "startDate": {
            "type": "string",
            "example": "2026-05-04",
            "description": "ISO date (YYYY-MM-DD)."
          },
          "durationDays": {
            "type": "number",
            "minimum": 1,
            "example": 10
          }
        },
        "required": [
          "name",
          "startDate",
          "durationDays"
        ]
      },
      "AddTaskDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "example": "Implement login"
          },
          "effortDays": {
            "type": "number",
            "minimum": 1,
            "example": 2
          },
          "category": {
            "type": "string",
            "enum": [
              "FEATURE",
              "BUG",
              "INFRA",
              "SRE",
              "ON_CALL",
              "DOCS",
              "RESEARCH"
            ],
            "example": "FEATURE"
          },
          "domain": {
            "type": "string",
            "minLength": 1,
            "example": "auth"
          },
          "deadlineDay": {
            "type": "number",
            "minimum": 0,
            "example": 4
          },
